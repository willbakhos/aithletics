# Copy to .env.local and fill in

DATABASE_URL="postgresql://user:pass@localhost:5432/aithletics?schema=public"

# Used to sign the session cookie (HS256). Min 16 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# 32-byte key, base64-encoded, used for AES-256-GCM encryption of stored
# OpenRouter API keys. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OPENROUTER_KEY_ENCRYPTION_KEY=""

# Race loop tuning
RACE_INTERVAL_MS=1200000
RACE_LOOP_TICK_MS=5000
COACHING_WINDOW_MS=900000
MAX_RACE_ENTRIES=8

# Gate admin routes with this header value
ADMIN_TOKEN=""
