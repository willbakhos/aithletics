# Copy to .env.local and fill in

DATABASE_URL="postgresql://user:pass@localhost:5432/aithletics?schema=public"

# libsodium-compatible 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OPENROUTER_KEY_ENCRYPTION_KEY=""

# Race loop tuning
RACE_INTERVAL_MS=1200000
COACHING_WINDOW_MS=900000
MAX_RACE_ENTRIES=8

# Gate admin routes with this header value
ADMIN_TOKEN=""
